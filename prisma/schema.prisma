generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id         String   @id @default(cuid())
  name       String
  domain     String
  brandVoice String?
  createdAt  DateTime @default(now())
  pages      Page[]
}

model Page {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  title         String
  slug          String
  content       String
  keyword       String?
  status        String   @default("draft")
  createdAt     DateTime @default(now())
}
